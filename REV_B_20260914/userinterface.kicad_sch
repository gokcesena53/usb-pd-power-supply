	(text "ENCODER: A=GPIO22, B=GPIO23, SW=GPIO21\n3.3V pull-ups; contacts close to GND.\nFirmware: quadrature state decoding and switch debounce required."
		(exclude_from_sim no)
		(at 182.88 158.75 0)
