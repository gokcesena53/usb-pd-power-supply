		(property "DesignNote" "47uF 35V hibrit; AOZ1284 cikisinda ~56kHz ESR sifiri, R41/C19 kompanzasyonu yeniden kontrol edilmeli."
			(at 302.26 195.58 0)
			(hide yes)
