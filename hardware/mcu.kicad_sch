			(do_not_autoplace no)
			(effects
				(font
					(size 1.27 1.27)
				)
			)
		)
		(property "DesignNote" "Karsi parca: Waveshare 2-CH UART TO ETH, 53 x 22 mm, CH9121. Pin sirasi ureticinin semasindan alindi (hardware/datasheets/2-CH_UART_TO_ETH_SCH.pdf, P1 Header 8X2). Modul 5V pininden AMS1117 ile 3V3 uretir; 3V3 pinleri dogrudan beslendigi icin LDO atlanir ve 5V pinleri bos birakilir. RJ45 entegre trafolu (CTTD/CTRD orta uclar) ama kabuk pedleri 13/14 dogrudan GND'ye bagli: STP kablo gopo toprapini bina toprapina baglar, UTP kullanilmali."
			(at 109.22 195.58 0)
			(hide yes)
			(show_name no)
			(do_not_autoplace no)
			(effects
				(font
					(size 1.27 1.27)
				)
			)
		)
		(property "SelectionNote" "SAMM Market MP02965; 634,89 TL + KDV; stok 19 (23.09.2026). Footprint Waveshare olcu cizimiyle cizildi; mekanik pin konumu numuneyle dogrulanacak (TASK-053)."
			(at 109.22 195.58 0)
			(hide yes)
			(show_name no)
			(do_not_autoplace no)
			(effects
				(font
					(size 1.27 1.27)
				)
			)
		)
		(property "AssemblyNote" "Standoff yok, dogrudan lehim. P2/P3 mekanik pinleri MP pedlerine lehimlenir (net yok). Header pinleri kart altindan ~4.4 mm cikar. RJ45 kart kenarindan 4.3 mm tasar."
			(at 109.22 195.58 0)
			(hide yes)
			(show_name no)
			(do_not_autoplace no)
			(effects
				(font
